{
  "modelVersion": "5.0.0",
  "dependencies": {
    "@ohos/hvigor": "6.26.4",
    "@ohos/hvigor-ohos-plugin": "6.26.4"
  },
  "execution": {
    "daemon": false,
    "incremental": true,
    "parallel": true
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 8192
  }
}
