<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tailscale mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tailscale Auth Key"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAuthKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="tskey-auth-..."
        android:inputType="text" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="登录 Tailscale 并启动接收" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="状态：未连接"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="在线设备"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvPeers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="暂无" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#CCCCCC" />

    <!-- Direct LAN mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="直连局域网模式（无需 Tailscale）"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStartDirect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="启动接收服务（直连模式）" />

    <TextView
        android:id="@+id/tvLocalIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="本机 IP：--"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="提示：两台设备连同一 Wi-Fi，发送端在分享时输入此 IP"
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>
